{
  "info": {
    "name": "CollabDocs API",
    "description": "All 17 CollabDocs endpoints. Run the folders top to bottom (or use the Collection Runner): each request saves the ids the next ones need as collection variables. Start the API first (python manage.py runserver) and change base_url if needed.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Users",
      "item": [
        {
          "name": "Create User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/users/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "users",
                ""
              ]
            },
            "description": "Creates a user. Email is lowercased and validated; email and phone must be unique (a duplicate returns 400). Saves the new id as {{user_id}}.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Ada\",\n  \"last_name\": \"Lovelace\",\n  \"email\": \"ada.{{$timestamp}}@example.com\",\n  \"phone\": \"+1{{$timestamp}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) {",
                  "    pm.collectionVariables.set(\"user_id\", pm.response.json().id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get User",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/users/{{user_id}}/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "users",
                "{{user_id}}",
                ""
              ]
            },
            "description": "Fetch a user by id (404 if it does not exist)."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Workspaces",
      "item": [
        {
          "name": "Create Workspace",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/workspaces/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "workspaces",
                ""
              ]
            },
            "description": "Creates the workspace and, in the same transaction, adds the owner as an admin member. Saves the id as {{workspace_id}}.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Engineering\",\n  \"owner\": \"{{user_id}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) {",
                  "    pm.collectionVariables.set(\"workspace_id\", pm.response.json().id);",
                  "}",
                  "pm.test(\"Owner is the only member\", () => pm.expect(pm.response.json().member_count).to.eql(1));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Workspace",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/workspaces/{{workspace_id}}/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "workspaces",
                "{{workspace_id}}",
                ""
              ]
            },
            "description": "Workspace with an annotated member_count."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Add Member",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/workspaces/{{workspace_id}}/members/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "workspaces",
                "{{workspace_id}}",
                "members",
                ""
              ]
            },
            "description": "Adds a user with a role (admin, editor or viewer). 404 for an unknown user and 409 if the user is already a member (try sending it twice).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": \"{{member_user_id}}\",\n  \"role\": \"editor\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Add Member needs a second user, so create one on the fly if none exists yet.",
                  "if (!pm.collectionVariables.get(\"member_user_id\")) {",
                  "    const stamp = Date.now();",
                  "    pm.sendRequest({",
                  "        url: pm.collectionVariables.get(\"base_url\") + \"/api/users/\",",
                  "        method: \"POST\",",
                  "        header: { \"Content-Type\": \"application/json\" },",
                  "        body: {",
                  "            mode: \"raw\",",
                  "            raw: JSON.stringify({",
                  "                first_name: \"Grace\",",
                  "                last_name: \"Hopper\",",
                  "                email: \"grace.\" + stamp + \"@example.com\",",
                  "                phone: \"+44\" + String(stamp).slice(0, 10),",
                  "            }),",
                  "        },",
                  "    }, (err, res) => {",
                  "        if (!err && res.code === 201) { pm.collectionVariables.set(\"member_user_id\", res.json().id); }",
                  "    });",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "List Members",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/workspaces/{{workspace_id}}/members/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "workspaces",
                "{{workspace_id}}",
                "members",
                ""
              ]
            },
            "description": "All members with their roles and nested user data."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Owner and editor are listed\", () => pm.expect(pm.response.json().length).to.eql(2));"
                ]
              }
            }
          ]
        },
        {
          "name": "Workspace Summary",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/workspaces/{{workspace_id}}/summary/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "workspaces",
                "{{workspace_id}}",
                "summary",
                ""
              ]
            },
            "description": "Document count, member count and total comments from a single aggregate query."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Documents",
      "item": [
        {
          "name": "Create Document",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/documents/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "documents",
                ""
              ]
            },
            "description": "Creates the document and its first version atomically. Saves the id as {{document_id}}.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Q4 launch plan\",\n  \"content\": \"Draft v1: outline the launch milestones.\",\n  \"workspace\": \"{{workspace_id}}\",\n  \"created_by\": \"{{user_id}}\",\n  \"status\": \"draft\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) {",
                  "    pm.collectionVariables.set(\"document_id\", pm.response.json().id);",
                  "}",
                  "pm.test(\"First version created\", () => pm.expect(pm.response.json().latest_version_number).to.eql(1));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update Document",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/documents/{{document_id}}/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "documents",
                "{{document_id}}",
                ""
              ]
            },
            "description": "Updates the content and saves a new version atomically. saved_by is optional and defaults to the document creator; created_by cannot be changed.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Q4 launch plan\",\n  \"content\": \"Draft v2: added owners and dates.\",\n  \"workspace\": \"{{workspace_id}}\",\n  \"created_by\": \"{{user_id}}\",\n  \"status\": \"draft\",\n  \"saved_by\": \"{{member_user_id}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Version 2 saved\", () => pm.expect(pm.response.json().latest_version_number).to.eql(2));"
                ]
              }
            }
          ]
        },
        {
          "name": "List Documents",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/documents/?workspace={{workspace_id}}&status=draft,published",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "documents",
                ""
              ],
              "query": [
                {
                  "key": "workspace",
                  "value": "{{workspace_id}}"
                },
                {
                  "key": "status",
                  "value": "draft,published"
                },
                {
                  "key": "tag",
                  "value": "python",
                  "disabled": true
                },
                {
                  "key": "search",
                  "value": "launch",
                  "disabled": true
                }
              ]
            },
            "description": "Paginated list. Filters: workspace (uuid), status (comma-separated), tag (name), search (title or content, case-insensitive). Disabled params can be switched on."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Returns the document\", () => pm.expect(pm.response.json().count).to.be.at.least(1));"
                ]
              }
            }
          ]
        },
        {
          "name": "Document Versions",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/documents/{{document_id}}/versions/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "documents",
                "{{document_id}}",
                "versions",
                ""
              ]
            },
            "description": "Every saved version of the document, in order."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Two versions\", () => pm.expect(pm.response.json().length).to.eql(2));"
                ]
              }
            }
          ]
        },
        {
          "name": "Document Stats",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/documents/{{document_id}}/stats/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "documents",
                "{{document_id}}",
                "stats",
                ""
              ]
            },
            "description": "Version count, comment count and distinct contributor count (aggregate())."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Two contributors\", () => pm.expect(pm.response.json().contributor_count).to.eql(2));"
                ]
              }
            }
          ]
        },
        {
          "name": "Add Tags to Document",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/documents/{{document_id}}/tags/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "documents",
                "{{document_id}}",
                "tags",
                ""
              ]
            },
            "description": "Attaches one or more tags by name, creating any that do not exist. Names are lowercased; re-sending the same tags is harmless.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tags\": [\n    \"python\",\n    \"django\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Tags attached\", () => pm.expect(pm.response.json().tag_names).to.eql([\"django\", \"python\"]));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Comments",
      "item": [
        {
          "name": "Add Comment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/comments/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "comments",
                ""
              ]
            },
            "description": "Adds a top-level comment, or a reply when parent is set. The first send creates a top-level comment and stores it as {{parent_id}}, so sending again creates a reply to it. Clear the parent_id variable to start a new top-level comment.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"document\": \"{{document_id}}\",\n  \"author\": \"{{user_id}}\",\n  \"content\": \"Looks good - can we add a rollout date?\",\n  \"parent\": \"{{parent_id}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) {",
                  "    pm.collectionVariables.set(\"comment_id\", pm.response.json().id);",
                  "}",
                  "if (pm.response.code === 201 && !pm.collectionVariables.get(\"parent_id\")) {",
                  "    pm.collectionVariables.set(\"parent_id\", pm.response.json().id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "List Comments",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/comments/?document={{document_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "comments",
                ""
              ],
              "query": [
                {
                  "key": "document",
                  "value": "{{document_id}}"
                }
              ]
            },
            "description": "All comments for a document as a nested tree (replies under their parent)."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Tags",
      "item": [
        {
          "name": "Create Tag",
          "request": {
