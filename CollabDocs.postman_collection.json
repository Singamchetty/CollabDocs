              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Audit Logs",
      "item": [
        {
          "name": "List Audit Logs",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/audit-logs/?actor={{user_id}}&date_from=2020-01-01&date_to=2099-12-31",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "audit-logs",
                ""
              ],
              "query": [
                {
                  "key": "actor",
                  "value": "{{user_id}}"
                },
                {
                  "key": "date_from",
                  "value": "2020-01-01"
                },
                {
                  "key": "date_to",
                  "value": "2099-12-31"
                }
              ]
            },
            "description": "Entries written by the Document post_save signal, newest first. Filter by actor id and an inclusive date range (ISO date or datetime)."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Document create and update were logged\", () => {",
                  "    const actions = pm.response.json().results.map(r => r.action);",
                  "    pm.expect(actions).to.include.members([\"created\", \"updated\"]);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
